{
  "ConnectionStrings": {
    "OrderFlowDb": "Host=localhost;Port=5433;Database=orderflow;Username=orderflow;Password=orderflow"
  },
  "Jwt": {
    "Issuer": "orderflow",
    "Audience": "orderflow-api",
    "SigningKey": "development-only-signing-key-change-me-in-every-real-environment",
    "ExpiryMinutes": 60
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPassword": "admin123",
    "SeedProducts": true
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "RegisterPermitLimit": 5,
    "RegisterWindowSeconds": 900,
    "TrustForwardedHeaders": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
